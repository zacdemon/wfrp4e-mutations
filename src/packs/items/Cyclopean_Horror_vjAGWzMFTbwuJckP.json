        "scriptData": [
          {
            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"grants\": [\n    {\n      \"roll\": \"1d10\",\n      \"text\": \"Eye\",\n      \"res\": [\n        [\n          1,\n          5,\n          {\n            \"t\": \"mod\",\n            \"k\": \"bs\",\n            \"half\": true\n          },\n          \"Eyes merge: halve BS\"\n        ],\n        [\n          6,\n          10,\n          {\n            \"note\": \"A head-sized eye grows on the body: roll Hit Location for where (custom armour there; 20% of hits there strike the eye with Damaging).\"\n          },\n          \"Extra eye\"\n        ]\n      ]\n    }\n  ]\n});",
            "label": "Add granted Talents, Traits and items",
