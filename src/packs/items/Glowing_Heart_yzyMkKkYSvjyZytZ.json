          {
            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"levels\": [\n    [\n      {\n        \"label\": \"Which hue does the light take on?\",\n        \"opts\": [\n          \"Red\",\n          \"Orange\",\n          \"Golden\",\n          \"Green\",\n          \"Blue\",\n          \"Violet\",\n          \"White\",\n          \"Sickly yellow\"\n        ]\n      }\n    ],\n    [\n      {\n        \"note\": \"The light and its radius double (12 yards for two copies, 24 for three...).\"\n      }\n    ]\n  ]\n});",
