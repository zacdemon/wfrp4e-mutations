            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"grants\": [\n    {\n      \"roll\": \"1d10\",\n      \"text\": \"Bloodsucker\",\n      \"res\": [\n        [\n          1,\n          8,\n          {\n            \"t\": \"mutation\",\n            \"n\": \"Fangs\",\n            \"u\": \"Compendium.artantares-mutations.items.Item.5V5B3xILSelJ8rXk\"\n          },\n          \"Fangs\"\n        ],\n        [\n          9,\n          10,\n          {\n            \"t\": \"mutation\",\n            \"n\": \"Piercing Tongue\",\n            \"u\": \"Compendium.artantares-mutations.items.Item.Lhia23lxUCCvOQ9l\"\n          },\n          \"Piercing Tongue\"\n        ]\n      ]\n    }\n  ]\n});",
