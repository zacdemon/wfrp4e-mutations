        "scriptData": [
          {
            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"levels\": [\n    [\n      {\n        \"t\": \"psychology\",\n        \"n\": \"Prejudice\",\n        \"u\": \"Compendium.wfrp4e-core.items.Item.klCJX0mNpXYH5AIx\",\n        \"ask\": \"Target of your suspicion\",\n        \"opts\": [\n          \"Academics\",\n          \"Agitators\",\n          \"Burghers\",\n          \"Enemies of Men\",\n          \"Cult of Sigmar\",\n          \"Law Enforcement\",\n          \"Nobles\",\n          \"Peasants\",\n          \"Rogues\",\n          \"Tax Collectors\",\n          \"Undead\",\n          \"Witches\",\n          \"Wizards\",\n          \"Witchhunters\"\n        ]\n      },\n      {\n        \"t\": \"talent\",\n        \"n\": \"Nose for Trouble\",\n        \"u\": \"Compendium.wfrp4e-core.items.Item.AcnFuDKRemLI9ey7\"\n      },\n      {\n        \"note\": \"You also gain Fear 1 towards your Target (no item).\"\n      }\n    ],\n    [\n      {\n        \"t\": \"psychology\",\n        \"n\": \"Prejudice\",\n        \"u\": \"Compendium.wfrp4e-core.items.Item.klCJX0mNpXYH5AIx\",\n        \"ask\": \"Additional Target of your suspicion\",\n        \"opts\": [\n          \"Academics\",\n          \"Agitators\",\n          \"Burghers\",\n          \"Enemies of Men\",\n          \"Cult of Sigmar\",\n          \"Law Enforcement\",\n          \"Nobles\",\n          \"Peasants\",\n          \"Rogues\",\n          \"Tax Collectors\",\n          \"Undead\",\n          \"Witches\",\n          \"Wizards\",\n          \"Witchhunters\"\n        ]\n      }\n    ]\n  ]\n});",
            "label": "Add granted Talents, Traits and items",
