            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"grants\": [\n    {\n      \"roll\": \"1d100\",\n      \"text\": \"Organ\",\n      \"res\": [\n        [\n          1,\n          25,\n          {\n            \"t\": \"talent\",\n            \"n\": \"Acute Sense\",\n            \"u\": \"Compendium.wfrp4e-core.items.Item.9h82z72XGo9tfgQS\",\n            \"s\": \"Sight\"\n          },\n          \"Eyes\"\n        ],\n        [\n          26,\n          50,\n          {\n            \"t\": \"talent\",\n            \"n\": \"Acute Sense\",\n            \"u\": \"Compendium.wfrp4e-core.items.Item.9h82z72XGo9tfgQS\",\n            \"s\": \"Hearing\"\n          },\n          \"Ears\"\n        ],\n        [\n          51,\n          75,\n          {\n            \"t\": \"talent\",\n            \"n\": \"Acute Sense\",\n            \"u\": \"Compendium.wfrp4e-core.items.Item.9h82z72XGo9tfgQS\",\n            \"s\": \"Smell\"\n          },\n          \"Nose\"\n        ],\n        [\n          76,\n          100,\n          {\n            \"t\": \"talent\",\n            \"n\": \"Acute Sense\",\n            \"u\": \"Compendium.wfrp4e-core.items.Item.9h82z72XGo9tfgQS\",\n            \"s\": \"Taste\"\n          },\n          \"Mouth\"\n        ]\n      ]\n    }\n  ]\n});",
