            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"grants\": [\n    {\n      \"t\": \"talent\",\n      \"n\": \"Ambidextrous\",\n      \"u\": \"Compendium.wfrp4e-core.items.Item.IFKWu98qmWpaSfUi\"\n    },\n    {\n      \"t\": \"mod\",\n      \"k\": \"i\",\n      \"v\": \"1d10\"\n    },\n    {\n      \"t\": \"mod\",\n      \"k\": \"int\",\n      \"v\": \"1d10\"\n    }\n  ]\n});",
