          {
            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"grants\": [\n    {\n      \"roll\": \"1d100\",\n      \"text\": \"Possessed\",\n      \"res\": [\n        [\n          1,\n          25,\n          {\n            \"t\": \"talent\",\n            \"n\": \"Menacing\",\n            \"u\": \"Compendium.wfrp4e-core.items.Item.0hn6UaKq8CoZP2zD\"\n          },\n          \"Khorne\"\n        ],\n        [\n          26,\n          50,\n          {\n            \"t\": \"talent\",\n            \"n\": \"Resistance\",\n            \"u\": \"Compendium.wfrp4e-core.items.Item.vMYEkrWj0ip6ZOdv\",\n            \"s\": \"Disease\"\n          },\n          \"Nurgle\"\n        ],\n        [\n          51,\n          75,\n          {\n            \"t\": \"talent\",\n            \"n\": \"Attractive\",\n            \"u\": \"Compendium.wfrp4e-core.items.Item.6l3jvIAvrKxt0lA9\"\n          },\n          \"Slaanesh\"\n        ],\n        [\n          76,\n          100,\n          {\n            \"t\": \"talent\",\n            \"n\": \"Cat-tongued\",\n            \"u\": \"Compendium.wfrp4e-core.items.Item.LzgxyMknSHjSkkeQ\"\n          },\n          \"Tzeentch\"\n        ]\n      ]\n    }\n  ]\n});",
