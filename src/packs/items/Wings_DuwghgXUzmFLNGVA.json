          {
            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"levels\": [\n    [\n      {\n        \"variant\": {\n          \"Small\": [\n            {\n              \"t\": \"talent\",\n              \"n\": \"Strong Legs\",\n              \"u\": \"Compendium.wfrp4e-core.items.Item.CV9btQn09S9Fn8Jk\"\n            }\n          ],\n          \"Medium\": [\n            {\n              \"t\": \"trait\",\n              \"n\": \"Flight\",\n              \"u\": \"Compendium.wfrp4e-core.items.Item.EO05HX7jql0g605A\",\n              \"s\": \"30\"\n            }\n          ],\n          \"Large\": [\n            {\n              \"t\": \"trait\",\n              \"n\": \"Flight\",\n              \"u\": \"Compendium.wfrp4e-core.items.Item.EO05HX7jql0g605A\",\n              \"s\": \"60\"\n            }\n          ],\n          \"Huge\": [\n            {\n              \"t\": \"trait\",\n              \"n\": \"Flight\",\n              \"u\": \"Compendium.wfrp4e-core.items.Item.EO05HX7jql0g605A\",\n              \"s\": \"120\"\n            }\n          ]\n        },\n        \"tbl\": \"Wings\",\n        \"key\": \"wings\"\n      }\n    ],\n    [\n      {\n        \"note\": \"Your wings grow by one degree: raise the Flight rating by hand (Small > Medium 30 > Large 60 > Huge 120).\"\n      }\n    ]\n  ]\n});",
