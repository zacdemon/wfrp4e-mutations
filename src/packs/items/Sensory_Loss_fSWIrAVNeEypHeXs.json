        "scriptData": [
          {
            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"grants\": [\n    {\n      \"roll\": \"1d10\",\n      \"text\": \"Sense\",\n      \"res\": [\n        [\n          1,\n          2,\n          {\n            \"note\": \"Hearing: remove Acute Sense (Hearing) and add 1d10 permanent Deafened by hand.\"\n          },\n          \"Hearing\"\n        ],\n        [\n          3,\n          4,\n          {\n            \"note\": \"Sight: remove Acute Sense (Sight) and add 1d10 permanent Blinded by hand.\"\n          },\n          \"Sight\"\n        ],\n        [\n          5,\n          6,\n          {\n            \"note\": \"Smell: remove Acute Sense (Smell) by hand.\"\n          },\n          \"Smell\"\n        ],\n        [\n          7,\n          8,\n          {\n            \"note\": \"Taste: remove Acute Sense (Taste) by hand.\"\n          },\n          \"Taste\"\n        ],\n        [\n          9,\n          10,\n          [\n            {\n              \"t\": \"trait\",\n              \"n\": \"Painless\",\n              \"u\": \"Compendium.wfrp4e-core.items.Item.wMwSRDmgiF2IdCJr\"\n            },\n            {\n              \"t\": \"mod\",\n              \"k\": \"ws\",\n              \"v\": \"-1d10\"\n            },\n            {\n              \"t\": \"mod\",\n              \"k\": \"dex\",\n              \"v\": \"-2d10\"\n            },\n            {\n              \"note\": \"Touch: remove Acute Sense (Touch) by hand.\"\n            }\n          ],\n          \"Touch\"\n        ]\n      ]\n    }\n  ]\n});",
