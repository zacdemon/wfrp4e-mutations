        "scriptData": [
          {
            "label": "Power item not on me: -1 Fortune",
            "trigger": "manual",
            "script": "const r = await game.modules.get(\"artantares-mutations\")?.api?.adjustStatus(this.actor, { fortune: -1 }, \"Power Item Obsession: item not on you\");\nawait this.effect.update({ \"flags.artantares-mutations.lost\": -(r?.applied?.fortune ?? 0) });",
            "options": {}
          },
          {
            "label": "Power item back: +1 Fortune",
            "trigger": "manual",
            "script": "const n = Number(this.effect.getFlag(\"artantares-mutations\", \"lost\")) || 0;\nif (n) await game.modules.get(\"artantares-mutations\")?.api?.adjustStatus(this.actor, { fortune: n }, \"Power Item Obsession: item back\");\nawait this.effect.update({ \"flags.artantares-mutations.lost\": 0 });",
            "options": {
              "hideScript": "return !(Number(this.effect.getFlag(\"artantares-mutations\", \"lost\")) > 0);"
            }
          }
