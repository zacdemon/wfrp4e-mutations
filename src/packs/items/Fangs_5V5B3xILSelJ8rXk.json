          {
            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"levels\": [\n    [\n      {\n        \"t\": \"trait\",\n        \"n\": \"Bite\",\n        \"u\": \"Compendium.wfrp4e-core.items.Item.pLW9SVX0TVTYPiPv\",\n        \"d\": 3\n      },\n      {\n        \"roll\": \"1d10\",\n        \"text\": \"Fangs\",\n        \"res\": [\n          [\n            1,\n            7,\n            null,\n            \"-\"\n          ],\n          [\n            8,\n            9,\n            {\n              \"t\": \"trait\",\n              \"n\": \"Venom\",\n              \"u\": \"Compendium.wfrp4e-core.items.Item.gFkRm9wS65qe18Xv\",\n              \"s\": \"Average\"\n            },\n            \"Venom (Average)\"\n          ],\n          [\n            10,\n            10,\n            {\n              \"t\": \"mutation\",\n              \"n\": \"Bloodsucker\",\n              \"u\": \"Compendium.artantares-mutations.items.Item.ZoRt8G8M0xyfdQpY\"\n            },\n            \"Bloodsucker\"\n          ]\n        ]\n      }\n    ],\n    [\n      {\n        \"t\": \"bump\",\n        \"n\": \"Bite\",\n        \"d\": 1\n      }\n    ]\n  ]\n});",
