            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"grants\": [\n    {\n      \"t\": \"mutation\",\n      \"n\": \"Dark Vision\",\n      \"u\": \"Compendium.artantares-mutations.items.Item.gvaCIj4BqHLSR5eE\"\n    },\n    {\n      \"t\": \"talent\",\n      \"n\": \"Tunnel Rat\",\n      \"u\": \"Compendium.wfrp4e-core.items.Item.Z91GFaT6FhEwyESU\"\n    },\n    {\n      \"t\": \"talent\",\n      \"n\": \"Scale Sheer Surfaces\",\n      \"u\": \"Compendium.wfrp4e-core.items.Item.MGEPI4jNhymNIRVz\"\n    }\n  ]\n});",
