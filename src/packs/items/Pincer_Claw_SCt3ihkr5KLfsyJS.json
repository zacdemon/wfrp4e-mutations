          {
            "script": "const api = game.modules.get(\"artantares-mutations\")?.api;\nif (!api?.grant) return ui.notifications.warn(`${this.item.name}: Antares | Mutant's Handbook is not active, so nothing was added.`);\nawait api.grant(this, {\n  \"grants\": [\n    {\n      \"t\": \"trait\",\n      \"n\": \"Weapon\",\n      \"u\": \"Compendium.wfrp4e-core.items.Item.AtpAudHA4ybXVlWM\",\n      \"d\": 4,\n      \"l\": \"Pincer Claw\"\n    },\n    {\n      \"t\": \"trait\",\n      \"n\": \"Constrictor\",\n      \"u\": \"Compendium.wfrp4e-core.items.Item.KynNUYYKzTMeHrKl\"\n    },\n    {\n      \"t\": \"mutation\",\n      \"n\": \"Protective Skin\",\n      \"v\": \"Carapace\",\n      \"tbl\": \"Protective Skin\",\n      \"locs\": [\n        \"rArm\"\n      ],\n      \"u\": \"Compendium.artantares-mutations.items.Item.JIv9RZGeYoaPPGiM\"\n    },\n    {\n      \"note\": \"Protective Skin (Carapace) covers the clawed arm only (set to the right arm; edit the armour item if it is the left).\"\n    }\n  ]\n});",
